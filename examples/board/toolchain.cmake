# Portable toolchain for an AArch64 Linux target. Set the installation root at configure time.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(AARCH64_TOOLCHAIN_ROOT "" CACHE PATH "aarch64-none-linux-gnu toolchain installation")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AARCH64_TOOLCHAIN_ROOT)
if(NOT AARCH64_TOOLCHAIN_ROOT)
  message(FATAL_ERROR "Set AARCH64_TOOLCHAIN_ROOT to your compiler installation")
endif()
if(CMAKE_HOST_WIN32)
  set(_suffix .exe)
else()
  set(_suffix "")
endif()
set(_prefix "${AARCH64_TOOLCHAIN_ROOT}/bin/aarch64-none-linux-gnu-")
set(CMAKE_C_COMPILER "${_prefix}gcc${_suffix}")
set(CMAKE_CXX_COMPILER "${_prefix}g++${_suffix}")
set(CMAKE_AR "${_prefix}ar${_suffix}")
set(CMAKE_RANLIB "${_prefix}ranlib${_suffix}")
set(CMAKE_STRIP "${_prefix}strip${_suffix}")
set(CMAKE_FIND_ROOT_PATH "${AARCH64_TOOLCHAIN_ROOT}/aarch64-none-linux-gnu/libc")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
